# Maintainer: noBGP, Inc. <support@nobgp.com>
#
# Generated by .github/workflows/release.yml from packaging/aur/PKGBUILD.in;
# edit the template, not the copy in a release or in the AUR repo.
pkgname=nobgp-omarchy-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='noBGP for Omarchy: your private network in the bar, the menu and a keyboard-driven TUI'
arch=('x86_64' 'aarch64')
url='https://github.com/nobgp/nobgp-omarchy'
license=('MIT')
depends=('sudo' 'wl-clipboard')
optdepends=('openssh: ssh to peers from the Peers tab')
provides=('nobgp-omarchy')
conflicts=('nobgp-omarchy')
backup=('etc/sudoers.d/nobgp-omarchy')
install=nobgp-omarchy-bin.install
options=('!debug' '!strip')
source_x86_64=("${url}/releases/download/v${pkgver}/nobgp-omarchy-${pkgver}-linux-amd64.tar.gz")
source_aarch64=("${url}/releases/download/v${pkgver}/nobgp-omarchy-${pkgver}-linux-arm64.tar.gz")
sha256sums_x86_64=('@SHA_AMD64@')
sha256sums_aarch64=('@SHA_ARM64@')

package() {
  cd "nobgp-omarchy-${pkgver}"
  install -Dm755 nobgp-omarchy "${pkgdir}/usr/bin/nobgp-omarchy"
  install -Dm644 packaging/nobgp-omarchy.desktop "${pkgdir}/usr/share/applications/nobgp-omarchy.desktop"
  install -Dm644 packaging/nobgp.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/nobgp.png"
  # Lets the bar read `nobgp status --json` without a password; see the file.
  install -dm750 "${pkgdir}/etc/sudoers.d"
  install -Dm440 packaging/sudoers "${pkgdir}/etc/sudoers.d/nobgp-omarchy"
  install -Dm644 desktop/plugin/manifest.json "${pkgdir}/usr/share/nobgp-omarchy/plugin/manifest.json"
  install -Dm644 desktop/plugin/Status.qml "${pkgdir}/usr/share/nobgp-omarchy/plugin/Status.qml"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/nobgp-omarchy/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
